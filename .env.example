# copy to .env (never committed)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# BITS_DATA_DIR=/path/to/dataset   (default: ./dataset)

# ---- Course assistant LLMs (all free tiers, no card needed) ----
# Fill in at least one key; a provider left empty is skipped.
# Tried in this order; on a rate limit (429) or outage the next one is used.
# Format: provider:model, comma-separated. Providers: groq, openrouter, gemini.
LLM_PROVIDERS=groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-super-120b-a12b:free,gemini:gemini-3.5-flash

# Groq: key from https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: key from https://openrouter.ai/keys (free models end in ":free")
OPENROUTER_API_KEY=
# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
